# Harness durable layer — each project instance generates its own data.
harness.db
harness.db-wal
harness.db-shm

# macOS Finder metadata.
.DS_Store

# Node.js and Vite local output.
node_modules/
coverage/
.vite/
.cache/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local configuration. Templates remain tracked.
.[e]nv
.[e]nv.local
.[e]nv.*.local

# Browser-test artifacts.
playwright-report/
test-results/

# Rust build output for harness tooling.
target/
dist/

# Downloaded Harness CLI binary for installed project instances.
scripts/bin/harness-cli
scripts/bin/harness-cli.exe

.harness/*
!.harness/changesets/
!.harness/changesets/*.changeset.jsonl
